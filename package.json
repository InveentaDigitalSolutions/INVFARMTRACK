{
  "name": "invfarmtrack",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:dv": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dataverse:dry-run": "node scripts/dataverse/apply-schema.mjs --dry-run",
    "dataverse:apply": "node scripts/dataverse/apply-schema.mjs && node scripts/dataverse/generate-docs.mjs && node scripts/dataverse/generate-choicemap.mjs",
    "dataverse:seed": "node scripts/dataverse/seed-data.mjs",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "deploy:skip-build": "node scripts/deploy.mjs",
    "postinstall": "rm -f node_modules/@microsoft/power-apps-cli/node_modules/@ms/power-platform-api/tsconfig.json",
    "dataverse:docs": "node scripts/dataverse/generate-docs.mjs",
    "dataverse:seed-reset": "node scripts/dataverse/set-autonumber-seed.mjs",
    "dataverse:token": "node scripts/dev-token.mjs",
    "dataverse:choices": "node scripts/dataverse/generate-choicemap.mjs",
    "dataverse:check": "node scripts/dataverse/check-choices.mjs",
    "dataverse:seed-fix": "node scripts/dataverse/fix-autonumber-seeds.mjs",
    "test:math": "tsx scripts/test/invoiceMath.test.mts",
    "test:rules": "tsx scripts/test/infrastructureRules.test.mts",
    "test": "npm run test:math && npm run test:rules && npm run test:rotation && npm run test:schedule && npm run test:forecast && npm run test:insight && npm run test:availability && npm run test:beds && npm run test:stock && npm run test:variety && npm run test:modules && npm run test:sync && npm run test:payload",
    "dataverse:photos": "node scripts/dataverse/sync-user-photos.mjs",
    "test:rotation": "tsx scripts/test/bedRotation.test.mts",
    "test:schedule": "tsx scripts/test/productionSchedule.test.mts",
    "dataverse:check-columns": "node scripts/dataverse/check-columns.mjs",
    "test:forecast": "tsx scripts/test/demandForecast.test.mts",
    "test:insight": "tsx scripts/test/productionInsight.test.mts",
    "test:availability": "tsx scripts/test/availabilityInsight.test.mts",
    "test:beds": "tsx scripts/test/expandBeds.test.mts",
    "dataverse:verify-writes": "node scripts/dataverse/verify-writes.mjs",
    "test:stock": "tsx scripts/test/stock.test.mts",
    "test:variety": "tsx scripts/test/varietySupply.test.mts",
    "dataverse:census": "node scripts/dataverse/census.mjs",
    "dataverse:purge": "node scripts/dataverse/purge-data.mjs",
    "dataverse:rowtypes": "node scripts/dataverse/generate-rowtypes.mjs",
    "test:modules": "tsx scripts/test/moduleInsight.test.mts",
    "dataverse:check-writes": "node scripts/dataverse/check-writes.mjs",
    "test:sync": "tsx scripts/test/syncPlan.test.mts",
    "test:payload": "tsx scripts/test/payload.test.mts",
    "dataverse:check-blank-saves": "tsx scripts/dataverse/check-blank-saves.mts",
    "test:smoke": "npm run build && node scripts/test/smoke.mjs",
    "test:sandbox": "node scripts/test/check-sandbox-safe.mjs"
  },
  "dependencies": {
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@microsoft/power-apps": "^1.0.4",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/mapbox-gl": "^3.4.1",
    "framer-motion": "^12.34.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.575.0",
    "mapbox-gl": "^3.21.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.2",
    "tailwindcss": "^4.2.1",
    "three": "^0.185.1",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@microsoft/power-apps-vite": "^1.0.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
